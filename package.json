{
  "name": "vireocode-web-app-starter-tools",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "generate": "node tools/generators/cli.mjs",
    "generate:samples": "node tools/generators/samples.mjs",
    "test:generators": "node --test --test-concurrency=1 tools/generators/tests/*.test.mjs",
    "verify:generated": "node tools/generators/rehearse.mjs"
  }
}
