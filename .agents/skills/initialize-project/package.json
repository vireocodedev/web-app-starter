{
  "name": "initialize-project-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "scripts": {
    "init:status": "node scripts/project-status.mjs",
    "init:capture": "node scripts/fetch-preparation.mjs",
    "docs:build": "node scripts/project-docs.mjs",
    "docs:check": "node scripts/project-docs.mjs --check",
    "test:preparation": "node --test tests/preparation/*.test.mjs",
    "test:docs": "node --test tests/project-docs.test.mjs",
    "browser:install": "playwright install chromium",
    "test:browser": "node --test tests/browser.test.mjs",
    "test:portable-install": "node tests/portable-install.mjs",
    "test:contract": "python3 -B -m unittest discover -s tests -p test_contract.py",
    "test": "npm run test:preparation && npm run test:docs && npm run test:contract && npm run test:browser",
    "verify": "npm test && npm run docs:check"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "playwright": "1.63.0"
  }
}
