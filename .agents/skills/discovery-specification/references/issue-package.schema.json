{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery specification issue package",
  "description": "Paths resolve from the package root except issue bodyFile, which resolves from issues/. The offline importer additionally validates local bytes, approvals, graph references and source JSON Pointers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "reviewStatus", "repository", "source", "labelsFile", "issues"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reviewStatus": { "enum": ["draft", "approved"] },
    "repository": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$" }] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "baselineId", "baselineVersion", "contentHash", "exportFile", "exportFileSha256", "environment"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "baselineId": { "type": "string", "minLength": 1 },
        "baselineVersion": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "exportFile": { "const": "source/approved-export.json" },
        "exportFileSha256": { "$ref": "#/$defs/sha256" },
        "environment": { "const": "production" }
      }
    },
    "labelsFile": { "const": "issues/labels.json" },
    "issues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$" },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "bodyFile", "parent", "blockedBy", "decisionBlockers", "sourceRefs", "labels", "ownerBoundary", "readiness"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "enum": ["initiative", "epic", "story", "task", "decision"] },
        "title": { "type": "string", "minLength": 1 },
        "bodyFile": { "type": "string", "pattern": "^bodies/[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*\\.md$" },
        "parent": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/key" }] },
        "blockedBy": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "decisionBlockers": { "$ref": "#/$defs/strings" },
        "sourceRefs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id", "path"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$", "description": "RFC6901 JSON Pointer into source/approved-export.json." }
            }
          }
        },
        "labels": { "$ref": "#/$defs/strings" },
        "ownerBoundary": { "type": "string", "minLength": 1 },
        "readiness": { "enum": ["ready-for-spec-review", "blocked-by-decision"] }
      },
      "allOf": [{
        "if": { "properties": { "decisionBlockers": { "minItems": 1 } } },
        "then": { "properties": { "readiness": { "const": "blocked-by-decision" } } },
        "else": { "properties": { "readiness": { "const": "ready-for-spec-review" } } }
      }]
    }
  }
}
