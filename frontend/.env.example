VITE_API_BASE_URL=/api
VITE_API_WITH_CREDENTIALS=true
VITE_API_MODE=http
VITE_APP_ENV=development
VITE_REQUEST_TIMEOUT_MS=15000

# Optional build-time policy. Uncomment a value to fix that setting and remove
# its controls. These public values are bundled into the app; changing one
# requires a rebuild.
# VITE_SETTINGS_NOCFG_LOCALE=en # en | hr
# VITE_SETTINGS_NOCFG_MOTION=system # system | reduce
# VITE_SETTINGS_NOCFG_LINK_UNDERLINES=page # page | always
# VITE_SETTINGS_NOCFG_DRAWER_MODE=permanent # temporary | permanent
# VITE_SETTINGS_NOCFG_HEADER_STICKINESS=first-row # first-row | both-rows | none
# VITE_SETTINGS_NOCFG_FONT_SIZE=medium # normal | medium | big
# VITE_SETTINGS_NOCFG_INCREASED_CONTRAST=false # true | false
# VITE_SETTINGS_NOCFG_DESKTOP_TABLE_SIZE=medium # small | medium
# VITE_SETTINGS_NOCFG_THEME=system # system | light | dark | soft-dark
# VITE_SETTINGS_NOCFG_EDITOR_PRESENTATION=docked # dialog | docked | overlay
# VITE_SETTINGS_NOCFG_SURFACE_BORDER_RADIUS=8 # 6 | 8 | 10 | 12 | 14 | 16 | 18

# Optional hosted Pattern source links when Git metadata is unavailable or the
# repository is not on git.rgo.hr. Include the revision and app directory prefix.
# RGO_EXAMPLE_SOURCE_BASE_URL=https://git.example.com/team/app/src/commit/REVISION/
