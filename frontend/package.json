{
  "name": "rgo-frontend-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:architecture": "node scripts/verify-application-architecture.mjs",
    "guide:index": "node scripts/development-guide-index.mjs",
    "verify:dev-guide": "node --test scripts/tests/development-guide-index.test.mjs && node scripts/verify-development-guide.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:browser:fixed-settings": "RGO_FIXED_SETTINGS_BROWSER=true VITE_SETTINGS_NOCFG_LOCALE=en VITE_SETTINGS_NOCFG_DRAWER_MODE=permanent VITE_SETTINGS_NOCFG_HEADER_STICKINESS=both-rows VITE_SETTINGS_NOCFG_FONT_SIZE=big VITE_SETTINGS_NOCFG_DESKTOP_TABLE_SIZE=medium VITE_SETTINGS_NOCFG_THEME=soft-dark VITE_SETTINGS_NOCFG_INCREASED_CONTRAST=true VITE_SETTINGS_NOCFG_MOTION=reduce VITE_SETTINGS_NOCFG_LINK_UNDERLINES=always VITE_SETTINGS_NOCFG_EDITOR_PRESENTATION=overlay VITE_SETTINGS_NOCFG_SURFACE_BORDER_RADIUS=18 playwright test --grep @fixed-settings",
    "test:browser:development": "playwright test --config playwright.development.config.ts",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run format:check && npm run lint && npm run verify:architecture && npm run verify:dev-guide && npm run typecheck && npm run test && npm run build && npm run build-storybook"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@preact/signals-react": "^3.12.0",
    "@rgo-web/frontend": "1.0.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/signals-react-transform": "^0.8.0",
    "@rolldown/plugin-babel": "^0.2.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "prettier": "^3.5.3",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
