{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: prepare local credentials",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/backend/scripts/with-local-node.sh",
        "${workspaceFolder}/backend/scripts/setup-local.mjs"
      ],
      "problemMatcher": []
    },
    {
      "label": "Backend: start local PostgreSQL",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/backend/scripts/with-local-node.sh",
        "${workspaceFolder}/backend/scripts/start-local.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": "Backend: prepare local credentials",
      "problemMatcher": []
    }
  ]
}
